# Base pública HTTPS en producción. No usar barra final.
APP_URL=http://localhost:3000

# MySQL 8.0.16+ / MySQL 8.4 recomendado.
# En hosting compartido reemplaza host, puerto, usuario y base por los entregados por cPanel.
# Codifica los caracteres especiales de la contraseña como URL antes de insertarla.
DATABASE_URL=mysql://renacer:renacer_local@127.0.0.1:3306/renacer?connection_limit=5&pool_timeout=10

# integration | production
WEBPAY_ENV=integration
WEBPAY_COMMERCE_CODE=597055555532
WEBPAY_API_KEY_SECRET=YOUR_TRANSBANK_INTEGRATION_SECRET

NEXT_PUBLIC_CONTACT_PHONE=+56993409633
NEXT_PUBLIC_CONTACT_EMAIL=ventas@renacerdistribuidora.cl
NEXT_PUBLIC_WHATSAPP_NUMBER=56991851942
NEXT_PUBLIC_BUSINESS_CITY=Antofagasta, Chile

# Administración /admin
# El usuario por defecto es "admin" si ADMIN_USERNAME no está definido.
# Usa una contraseña exclusiva y un secreto aleatorio de al menos 32 caracteres.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
ADMIN_SESSION_SECRET=change-this-admin-session-secret-at-least-32-characters

# Opcional: correo transaccional vía API de Resend.
RESEND_API_KEY=
ORDER_FROM_EMAIL=pedidos@tu-dominio.cl
ORDER_NOTIFICATION_EMAIL=ventas@renacerdistribuidora.cl

# Cambiar por un secreto largo y aleatorio antes de producción.
CSRF_SECRET=change-this-in-production-with-at-least-32-characters

CRON_SECRET=change-this-cron-secret-in-production

# Mantener en false hasta completar credenciales, pruebas y certificación Webpay.
PAYMENTS_ENABLED=false
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# -----------------------------------------------------------------------------
# SII CHILE · DTE (boleta electrónica tipo 39 / factura electrónica tipo 33)
# -----------------------------------------------------------------------------
# Seguridad: dejar SII_ENABLED=false hasta completar certificación y credenciales.
# SII_ENV: mock | certification | production
# SII_PROVIDER: mock | gateway
# - mock: simula aceptación y NO envía al SII.
# - gateway: envía el DTE a un servicio de firma/integración SII configurable.
SII_ENABLED=false
SII_ENV=mock
SII_PROVIDER=mock
SII_VAT_RATE=19
SII_AUTO_ISSUE_BOLETA=false

# Datos tributarios del emisor. Completar con los datos inscritos ante el SII.
SII_RUT_EMISOR=
SII_RUT_ENVIA=
SII_RAZON_SOCIAL=
SII_GIRO=
SII_ACTECO=
SII_DIRECCION=
SII_COMUNA=
SII_CIUDAD=

# Gateway/integrador SII. Solo se usa con SII_PROVIDER=gateway.
# Debe aceptar POST JSON con el DTE y devolver trackId/status/xml firmado.
SII_GATEWAY_SUBMIT_URL=
SII_GATEWAY_STATUS_URL=
SII_GATEWAY_TOKEN=

# Credenciales reservadas para integración/firma directa o para el servicio gateway.
# No exponer estas variables al navegador ni usar prefijo NEXT_PUBLIC_.
# PFX en Base64 y su clave. El PFX debe corresponder al certificado autorizado para DTE.
SII_CERT_PFX_BASE64=
SII_CERT_PASSWORD=

# CAF/Timbre electrónico por tipo de DTE, codificado en Base64.
# 39=Boleta, 33=Factura, 61=Nota de crédito, 56=Nota de débito.
SII_CAF_39_BASE64=
SII_CAF_33_BASE64=
SII_CAF_61_BASE64=
SII_CAF_56_BASE64=

# Endpoints oficiales SII. Se dejan vacíos para evitar fijar URLs no verificadas.
# Completar según el ambiente y la documentación oficial vigente antes de usar modo directo.
SII_SEED_URL=
SII_TOKEN_URL=
SII_DTE_UPLOAD_URL=
SII_DTE_STATUS_URL=
