generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UnitType {
  KG
  UNIT
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
  PAYMENT_REVIEW
  CANCELLED
  FULFILLING
  SHIPPED
  COMPLETED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  REJECTED
  CANCELLED
  FAILED
  REVIEW
  REFUNDED
}

enum InventoryMovementType {
  OPENING
  RECEIVE
  ISSUE
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  RESERVATION
  RESERVATION_RELEASE
  SALE
  RETURN
  PRODUCTION_CONSUME
  PRODUCTION_OUTPUT
}

enum PosPaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  TRANSFER
  OTHER
}

enum PosUserRole {
  CASHIER
  MANAGER
}

enum PosShiftStatus {
  OPEN
  CLOSED
}

enum PosCashMovementType {
  CASH_IN
  CASH_OUT
}

enum CustomerConsentKind {
  PRIVACY_NOTICE
  MARKETING
}

enum WarehouseVisualObjectType {
  RACK
  PALLET
  COLD_ROOM
  FREEZER
  FRIDGE
  TABLE
  WALL
  DOOR
  RECEIVING
  DISPATCH
  CUSTOM
}

enum WarehouseLocationMovementType {
  ALLOCATE
  INTERNAL_TRANSFER
  ADJUST
  UNASSIGN
  SYSTEM_DECREMENT
}

enum DteDocumentType {
  BOLETA_ELECTRONICA
  FACTURA_ELECTRONICA
  GUIA_DESPACHO
  NOTA_CREDITO
  NOTA_DEBITO
}

enum DteStatus {
  DRAFT
  GENERATED
  QUEUED
  SENT
  ACCEPTED
  OBSERVED
  REJECTED
  ERROR
  CANCELLED
}

enum DteEnvironment {
  MOCK
  CERTIFICATION
  PRODUCTION
}

enum DispatchType {
  SALE_DELIVERY
  INTERNAL_TRANSFER
  OTHER
}

enum DispatchStatus {
  DRAFT
  READY
  DISPATCHED
  RECEIVED
  CANCELLED
}

enum PurchaseOrderStatus {
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PurchaseReceiptDocumentType {
  GUIA_DESPACHO
  FACTURA
  BOLETA
  OTRO
}

enum LotMovementType {
  OPENING
  RECEIVE
  SALE
  ISSUE
  TRANSFER_OUT
  TRANSFER_IN
  RETURN
  ADJUSTMENT
  PRODUCTION_CONSUME
  PRODUCTION_OUTPUT
}

enum ProductionProcessType {
  DESPOSTE
  PORCIONADO
  MOLIENDA
  ENVASADO
  ELABORACION
  OTRO
}

enum ProductionWasteType {
  RECORTE
  HUESO
  GRASA
  MERMA_PROCESO
  DERRAME
  DETERIORO
  OTRO
}

model Product {
  id                         String                      @id @default(cuid()) @db.VarChar(30)
  slug                       String                      @unique @db.VarChar(191)
  name                       String                      @db.VarChar(191)
  description                String                      @db.Text
  category                   String                      @db.VarChar(100)
  imageUrl                   String                      @db.VarChar(500)
  price                      Int
  unit                       UnitType                    @default(KG)
  stock                      Decimal                     @default(0) @db.Decimal(14, 3)
  reserved                   Decimal                     @default(0) @db.Decimal(14, 3)
  active                     Boolean                     @default(true)
  featured                   Boolean                     @default(false)
  createdAt                  DateTime                    @default(now()) @db.DateTime(3)
  updatedAt                  DateTime                    @updatedAt @db.DateTime(3)
  orderItems                 OrderItem[]
  inventoryStocks            InventoryStock[]
  inventoryMovements         InventoryMovement[]
  posSaleItems               PosSaleItem[]
  posReturnItems             PosReturnItem[]
  dispatchItems              DispatchItem[]
  purchaseOrderItems         PurchaseOrderItem[]
  purchaseReceiptItems       PurchaseReceiptItem[]
  lots                       ProductLot[]
  productionInputs           ProductionInput[]
  productionOutputs          ProductionOutput[]
  productionWastes           ProductionWaste[]
  warehousePlacements        WarehouseProductPlacement[]
  warehouseLocationMovements WarehouseLocationMovement[]

  @@index([active, category])
}

model ProductImage {
  id        String   @id @default(cuid()) @db.VarChar(30)
  mimeType  String   @db.VarChar(50)
  byteSize  Int
  data      Bytes    @db.LongBlob
  createdAt DateTime @default(now()) @db.DateTime(3)
}

model StoreSetting {
  key       String   @id @db.VarChar(100)
  value     String   @db.VarChar(500)
  updatedAt DateTime @updatedAt @db.DateTime(3)
}

model Warehouse {
  id                         String                      @id @default(cuid()) @db.VarChar(30)
  code                       String                      @unique @db.VarChar(40)
  name                       String                      @db.VarChar(191)
  address                    String?                     @db.VarChar(255)
  active                     Boolean                     @default(true)
  isDefault                  Boolean                     @default(false)
  createdAt                  DateTime                    @default(now()) @db.DateTime(3)
  updatedAt                  DateTime                    @updatedAt @db.DateTime(3)
  stocks                     InventoryStock[]
  movements                  InventoryMovement[]
  reservations               InventoryReservation[]
  posSales                   PosSale[]
  posReturns                 PosReturn[]
  dispatchesFrom             Dispatch[]                  @relation("DispatchSourceWarehouse")
  dispatchesTo               Dispatch[]                  @relation("DispatchDestinationWarehouse")
  purchaseOrders             PurchaseOrder[]
  productionBatches          ProductionBatch[]
  lotStocks                  InventoryLotStock[]
  lotMovements               InventoryLotMovement[]
  lotPlacements              WarehouseLotPlacement[]
  posSaleLotAllocations      PosSaleLotAllocation[]
  posReturnLotAllocations    PosReturnLotAllocation[]
  orderItemLotAllocations    OrderItemLotAllocation[]
  cashRegisters              CashRegister[]
  layout                     WarehouseLayout?
  productPlacements          WarehouseProductPlacement[]
  warehouseLocationMovements WarehouseLocationMovement[]

  @@index([active, name])
}

model WarehouseLayout {
  id          String                  @id @default(cuid()) @db.VarChar(30)
  warehouseId String                  @unique @db.VarChar(30)
  widthCm     Int
  depthCm     Int
  heightCm    Int
  createdAt   DateTime                @default(now()) @db.DateTime(3)
  updatedAt   DateTime                @updatedAt @db.DateTime(3)
  warehouse   Warehouse               @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  objects     WarehouseVisualObject[]

  @@index([warehouseId])
}

model WarehouseVisualObject {
  id            String                      @id @default(cuid()) @db.VarChar(30)
  layoutId      String                      @db.VarChar(30)
  type          WarehouseVisualObjectType
  label         String                      @db.VarChar(120)
  xCm           Int
  zCm           Int
  widthCm       Int
  depthCm       Int
  heightCm      Int
  rotation      Int                         @default(0)
  createdAt     DateTime                    @default(now()) @db.DateTime(3)
  updatedAt     DateTime                    @updatedAt @db.DateTime(3)
  layout        WarehouseLayout             @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  placements    WarehouseProductPlacement[]
  lotPlacements WarehouseLotPlacement[]

  @@index([layoutId])
}

model WarehouseProductPlacement {
  id           String                @id @default(cuid()) @db.VarChar(30)
  warehouseId  String                @db.VarChar(30)
  objectId     String                @db.VarChar(30)
  productId    String                @db.VarChar(30)
  locationCode String                @default("") @db.VarChar(80)
  quantity     Decimal               @default(0) @db.Decimal(14, 3)
  createdAt    DateTime              @default(now()) @db.DateTime(3)
  updatedAt    DateTime              @updatedAt @db.DateTime(3)
  warehouse    Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  object       WarehouseVisualObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  product      Product               @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([objectId, productId, locationCode])
  @@index([warehouseId, productId])
  @@index([objectId])
  @@index([productId])
}

model WarehouseLocationMovement {
  id               String                        @id @default(cuid()) @db.VarChar(30)
  warehouseId      String                        @db.VarChar(30)
  productId        String                        @db.VarChar(30)
  type             WarehouseLocationMovementType
  quantity         Decimal                       @db.Decimal(14, 3)
  locatedAfter     Decimal                       @db.Decimal(14, 3)
  fromObjectId     String?                       @db.VarChar(30)
  fromObjectLabel  String?                       @db.VarChar(120)
  fromLocationCode String?                       @db.VarChar(80)
  toObjectId       String?                       @db.VarChar(30)
  toObjectLabel    String?                       @db.VarChar(120)
  toLocationCode   String?                       @db.VarChar(80)
  reference        String?                       @db.VarChar(100)
  note             String?                       @db.VarChar(500)
  actor            String                        @db.VarChar(80)
  createdAt        DateTime                      @default(now()) @db.DateTime(3)
  warehouse        Warehouse                     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product          Product                       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([warehouseId, createdAt])
  @@index([productId, createdAt])
}

model InventoryStock {
  id          String    @id @default(cuid()) @db.VarChar(30)
  warehouseId String    @db.VarChar(30)
  productId   String    @db.VarChar(30)
  onHand      Decimal   @default(0) @db.Decimal(14, 3)
  reserved    Decimal   @default(0) @db.Decimal(14, 3)
  minStock    Decimal   @default(0) @db.Decimal(14, 3)
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @db.DateTime(3)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, productId])
  @@index([productId])
}

model InventoryMovement {
  id            String                @id @default(cuid()) @db.VarChar(30)
  warehouseId   String                @db.VarChar(30)
  productId     String                @db.VarChar(30)
  type          InventoryMovementType
  quantity      Decimal               @db.Decimal(14, 3)
  onHandAfter   Decimal               @db.Decimal(14, 3)
  reservedAfter Decimal               @db.Decimal(14, 3)
  note          String?               @db.VarChar(500)
  reference     String?               @db.VarChar(100)
  createdAt     DateTime              @default(now()) @db.DateTime(3)
  warehouse     Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product       Product               @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([warehouseId, createdAt])
}

model InventoryReservation {
  id          String    @id @default(cuid()) @db.VarChar(30)
  orderItemId String    @db.VarChar(30)
  warehouseId String    @db.VarChar(30)
  quantity    Decimal   @db.Decimal(14, 3)
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, warehouseId])
  @@index([warehouseId])
}

model PosUser {
  id        String      @id @default(cuid()) @db.VarChar(30)
  username  String      @unique @db.VarChar(80)
  name      String      @db.VarChar(191)
  pinHash   String      @db.VarChar(191)
  role      PosUserRole @default(CASHIER)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now()) @db.DateTime(3)
  updatedAt DateTime    @updatedAt @db.DateTime(3)
  shifts    PosShift[]
  sales     PosSale[]   @relation("PosCashierSales")

  @@index([active, name])
}

model CashRegister {
  id          String     @id @default(cuid()) @db.VarChar(30)
  code        String     @unique @db.VarChar(40)
  name        String     @db.VarChar(191)
  warehouseId String     @db.VarChar(30)
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now()) @db.DateTime(3)
  updatedAt   DateTime   @updatedAt @db.DateTime(3)
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  shifts      PosShift[]

  @@index([active, name])
  @@index([warehouseId])
}

model PosShift {
  id            String         @id @default(cuid()) @db.VarChar(30)
  registerId    String         @db.VarChar(30)
  userId        String         @db.VarChar(30)
  status        PosShiftStatus @default(OPEN)
  openingAmount Int            @default(0)
  expectedCash  Int?
  declaredCash  Int?
  difference    Int?
  openingNotes  String?        @db.VarChar(500)
  closingNotes  String?        @db.VarChar(500)
  openedAt      DateTime       @default(now()) @db.DateTime(3)
  closedAt      DateTime?      @db.DateTime(3)
  register      CashRegister   @relation(fields: [registerId], references: [id], onDelete: Restrict)
  user          PosUser        @relation(fields: [userId], references: [id], onDelete: Restrict)
  sales         PosSale[]
  returns       PosReturn[]
  cashMovements PosCashMovement[]

  @@index([status, openedAt])
  @@index([registerId, status])
  @@index([userId, status])
}

model PosCashMovement {
  id        String              @id @default(cuid()) @db.VarChar(30)
  shiftId   String              @db.VarChar(30)
  type      PosCashMovementType
  amount    Int
  reason    String              @db.VarChar(500)
  createdAt DateTime            @default(now()) @db.DateTime(3)
  shift     PosShift            @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  posReturn PosReturn?

  @@index([shiftId, createdAt])
}

model Customer {
  id                     String                 @id @default(cuid()) @db.VarChar(30)
  rut                    String?                @unique @db.VarChar(20)
  name                   String                 @db.VarChar(191)
  email                  String?                @db.VarChar(191)
  phone                  String?                @db.VarChar(40)
  address                String?                @db.VarChar(255)
  active                 Boolean                @default(true)
  privacyNoticeVersion   String                 @db.VarChar(40)
  privacyAcknowledgedAt  DateTime?              @db.DateTime(3)
  privacySource          String?                @db.VarChar(80)
  marketingConsent       Boolean                @default(false)
  marketingConsentAt     DateTime?              @db.DateTime(3)
  marketingConsentSource String?                @db.VarChar(80)
  anonymizedAt           DateTime?              @db.DateTime(3)
  createdAt              DateTime               @default(now()) @db.DateTime(3)
  updatedAt              DateTime               @updatedAt @db.DateTime(3)
  posSales               PosSale[]
  consentEvents          CustomerConsentEvent[]

  @@index([active, name])
  @@index([email])
  @@index([phone])
}

model CustomerConsentEvent {
  id            String              @id @default(cuid()) @db.VarChar(30)
  customerId    String              @db.VarChar(30)
  kind          CustomerConsentKind
  granted       Boolean
  noticeVersion String?             @db.VarChar(40)
  source        String              @db.VarChar(80)
  createdAt     DateTime            @default(now()) @db.DateTime(3)
  customer      Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

model PosSale {
  id             String           @id @default(cuid()) @db.VarChar(30)
  saleNumber     String           @unique @db.VarChar(40)
  warehouseId    String           @db.VarChar(30)
  shiftId        String?          @db.VarChar(30)
  cashierId      String?          @db.VarChar(30)
  customerId     String?          @db.VarChar(30)
  customerName   String?          @db.VarChar(191)
  customerRut    String?          @db.VarChar(20)
  subtotal       Int
  discount       Int              @default(0)
  total          Int
  paymentMethod  PosPaymentMethod
  amountReceived Int?
  changeDue      Int              @default(0)
  notes          String?          @db.VarChar(500)
  cashier        String           @db.VarChar(80)
  createdAt      DateTime         @default(now()) @db.DateTime(3)
  warehouse      Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  shift          PosShift?        @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  cashierUser    PosUser?         @relation("PosCashierSales", fields: [cashierId], references: [id], onDelete: SetNull)
  customer       Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items          PosSaleItem[]
  returns        PosReturn[]
  dispatches     Dispatch[]
  dteDocuments   DteDocument[]

  @@index([createdAt])
  @@index([warehouseId, createdAt])
  @@index([shiftId, createdAt])
  @@index([cashierId, createdAt])
  @@index([customerId, createdAt])
}

model PosSaleItem {
  id             String                 @id @default(cuid()) @db.VarChar(30)
  saleId         String                 @db.VarChar(30)
  productId      String                 @db.VarChar(30)
  productName    String                 @db.VarChar(191)
  unit           UnitType
  quantity       Decimal                @db.Decimal(14, 3)
  unitPrice      Int
  subtotal       Int
  sale           PosSale                @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product        Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  returnItems    PosReturnItem[]
  lotAllocations PosSaleLotAllocation[]

  @@index([saleId])
  @@index([productId])
}

model PosReturn {
  id             String           @id @default(cuid()) @db.VarChar(30)
  returnNumber   String           @unique @db.VarChar(40)
  requestKey     String           @unique @db.VarChar(64)
  saleId         String           @db.VarChar(30)
  warehouseId    String           @db.VarChar(30)
  shiftId        String?          @db.VarChar(30)
  cashMovementId String?          @unique @db.VarChar(30)
  refundMethod   PosPaymentMethod
  grossAmount    Int
  discountAmount Int              @default(0)
  totalAmount    Int
  reason         String           @db.VarChar(500)
  createdAt      DateTime         @default(now()) @db.DateTime(3)
  sale           PosSale          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  warehouse      Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  shift          PosShift?        @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  cashMovement   PosCashMovement? @relation(fields: [cashMovementId], references: [id], onDelete: SetNull)
  items          PosReturnItem[]
  dteDocuments   DteDocument[]

  @@index([saleId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([shiftId, createdAt])
}

model PosReturnItem {
  id             String                   @id @default(cuid()) @db.VarChar(30)
  returnId       String                   @db.VarChar(30)
  saleItemId     String                   @db.VarChar(30)
  productId      String                   @db.VarChar(30)
  productName    String                   @db.VarChar(191)
  unit           UnitType
  quantity       Decimal                  @db.Decimal(14, 3)
  unitPrice      Int
  grossAmount    Int
  discountAmount Int                      @default(0)
  totalAmount    Int
  createdAt      DateTime                 @default(now()) @db.DateTime(3)
  posReturn      PosReturn                @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem       PosSaleItem              @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  product        Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  lotAllocations PosReturnLotAllocation[]

  @@index([returnId])
  @@index([saleItemId])
  @@index([productId])
}

model Dispatch {
  id                     String         @id @default(cuid()) @db.VarChar(30)
  dispatchNumber         String         @unique @db.VarChar(40)
  requestKey             String         @unique @db.VarChar(64)
  type                   DispatchType
  status                 DispatchStatus @default(DRAFT)
  sourceWarehouseId      String         @db.VarChar(30)
  destinationWarehouseId String?        @db.VarChar(30)
  saleId                 String?        @db.VarChar(30)
  orderId                String?        @db.VarChar(30)
  transferReasonCode     String?        @db.VarChar(10)
  reason                 String         @db.VarChar(500)
  receiverRut            String?        @db.VarChar(20)
  receiverName           String         @db.VarChar(191)
  receiverGiro           String?        @db.VarChar(191)
  receiverAddress        String         @db.VarChar(255)
  receiverCommune        String         @db.VarChar(120)
  receiverCity           String?        @db.VarChar(120)
  transportCompanyRut    String?        @db.VarChar(20)
  transportCompanyName   String?        @db.VarChar(191)
  driverRut              String?        @db.VarChar(20)
  driverName             String?        @db.VarChar(191)
  vehiclePlate           String?        @db.VarChar(20)
  trailerPlate           String?        @db.VarChar(20)
  notes                  String?        @db.VarChar(1000)
  dispatchedAt           DateTime?      @db.DateTime(3)
  receivedAt             DateTime?      @db.DateTime(3)
  createdAt              DateTime       @default(now()) @db.DateTime(3)
  updatedAt              DateTime       @updatedAt @db.DateTime(3)
  sourceWarehouse        Warehouse      @relation("DispatchSourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destinationWarehouse   Warehouse?     @relation("DispatchDestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  sale                   PosSale?       @relation(fields: [saleId], references: [id], onDelete: Restrict)
  order                  Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items                  DispatchItem[]
  dteDocuments           DteDocument[]

  @@index([status, createdAt])
  @@index([sourceWarehouseId, createdAt])
  @@index([destinationWarehouseId, createdAt])
  @@index([saleId])
  @@index([orderId])
}

model DispatchItem {
  id             String                  @id @default(cuid()) @db.VarChar(30)
  dispatchId     String                  @db.VarChar(30)
  productId      String                  @db.VarChar(30)
  productName    String                  @db.VarChar(191)
  unit           UnitType
  quantity       Decimal                 @db.Decimal(14, 3)
  unitPrice      Int
  amount         Int
  createdAt      DateTime                @default(now()) @db.DateTime(3)
  dispatch       Dispatch                @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  product        Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  lotAllocations DispatchLotAllocation[]

  @@index([dispatchId])
  @@index([productId])
}

model Supplier {
  id               String          @id @default(cuid()) @db.VarChar(30)
  code             String          @unique @db.VarChar(40)
  rut              String?         @unique @db.VarChar(20)
  name             String          @db.VarChar(191)
  contactName      String?         @db.VarChar(191)
  email            String?         @db.VarChar(191)
  phone            String?         @db.VarChar(40)
  address          String?         @db.VarChar(255)
  commune          String?         @db.VarChar(120)
  city             String?         @db.VarChar(120)
  paymentTermsDays Int             @default(0)
  notes            String?         @db.VarChar(1000)
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now()) @db.DateTime(3)
  updatedAt        DateTime        @updatedAt @db.DateTime(3)
  purchaseOrders   PurchaseOrder[]
  lots             ProductLot[]

  @@index([active, name])
  @@index([email])
}

model PurchaseOrder {
  id                String              @id @default(cuid()) @db.VarChar(30)
  orderNumber       String              @unique @db.VarChar(40)
  requestKey        String              @unique @db.VarChar(64)
  supplierId        String              @db.VarChar(30)
  warehouseId       String              @db.VarChar(30)
  status            PurchaseOrderStatus @default(ORDERED)
  expectedDate      DateTime?           @db.DateTime(3)
  supplierReference String?             @db.VarChar(100)
  vatRate           Int                 @default(19)
  netAmount         Int
  vatAmount         Int
  totalAmount       Int
  notes             String?             @db.VarChar(1000)
  orderedAt         DateTime            @default(now()) @db.DateTime(3)
  completedAt       DateTime?           @db.DateTime(3)
  cancelledAt       DateTime?           @db.DateTime(3)
  createdAt         DateTime            @default(now()) @db.DateTime(3)
  updatedAt         DateTime            @updatedAt @db.DateTime(3)
  supplier          Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse         Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items             PurchaseOrderItem[]
  receipts          PurchaseReceipt[]

  @@index([supplierId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([status, createdAt])
}

model PurchaseOrderItem {
  id                String                @id @default(cuid()) @db.VarChar(30)
  purchaseOrderId   String                @db.VarChar(30)
  productId         String                @db.VarChar(30)
  productName       String                @db.VarChar(191)
  unit              UnitType
  orderedQuantity   Decimal               @db.Decimal(14, 3)
  receivedQuantity  Decimal               @default(0) @db.Decimal(14, 3)
  unitCostNet       Int
  netAmount         Int
  createdAt         DateTime              @default(now()) @db.DateTime(3)
  updatedAt         DateTime              @updatedAt @db.DateTime(3)
  purchaseOrder     PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product           Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  receiptItems      PurchaseReceiptItem[]

  @@unique([purchaseOrderId, productId])
  @@index([productId])
}

model PurchaseReceipt {
  id                     String                       @id @default(cuid()) @db.VarChar(30)
  receiptNumber          String                       @unique @db.VarChar(40)
  requestKey             String                       @unique @db.VarChar(64)
  purchaseOrderId        String                       @db.VarChar(30)
  documentType           PurchaseReceiptDocumentType?
  supplierDocumentNumber String?                      @db.VarChar(100)
  receivedBy             String                       @db.VarChar(80)
  notes                  String?                      @db.VarChar(1000)
  receivedAt             DateTime                     @default(now()) @db.DateTime(3)
  createdAt              DateTime                     @default(now()) @db.DateTime(3)
  purchaseOrder          PurchaseOrder                @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  items                  PurchaseReceiptItem[]

  @@index([purchaseOrderId, receivedAt])
  @@index([supplierDocumentNumber])
}

model PurchaseReceiptItem {
  id                  String            @id @default(cuid()) @db.VarChar(30)
  purchaseReceiptId   String            @db.VarChar(30)
  purchaseOrderItemId String            @db.VarChar(30)
  productId           String            @db.VarChar(30)
  productName         String            @db.VarChar(191)
  unit                UnitType
  quantity            Decimal           @db.Decimal(14, 3)
  unitCostNet         Int
  netAmount           Int
  createdAt           DateTime          @default(now()) @db.DateTime(3)
  purchaseReceipt     PurchaseReceipt   @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  product             Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  lot                 ProductLot?

  @@unique([purchaseReceiptId, purchaseOrderItemId])
  @@index([purchaseOrderItemId])
  @@index([productId])
}

model ProductLot {
  id                    String                    @id @default(cuid()) @db.VarChar(30)
  internalCode          String                    @unique @db.VarChar(60)
  productId             String                    @db.VarChar(30)
  supplierId            String?                   @db.VarChar(30)
  purchaseReceiptItemId String?                   @unique @db.VarChar(30)
  supplierLotNumber     String?                   @db.VarChar(100)
  unitCostNet           Int?
  manufacturedAt        DateTime?                 @db.DateTime(3)
  expirationDate        DateTime?                 @db.DateTime(3)
  createdAt             DateTime                  @default(now()) @db.DateTime(3)
  updatedAt             DateTime                  @updatedAt @db.DateTime(3)
  product               Product                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplier              Supplier?                 @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseReceiptItem   PurchaseReceiptItem?      @relation(fields: [purchaseReceiptItemId], references: [id], onDelete: SetNull)
  stocks                InventoryLotStock[]
  movements             InventoryLotMovement[]
  placements            WarehouseLotPlacement[]
  posSaleAllocations    PosSaleLotAllocation[]
  posReturnAllocations  PosReturnLotAllocation[]
  orderAllocations      OrderItemLotAllocation[]
  dispatchAllocations   DispatchLotAllocation[]
  productionInputs      ProductionInput[]
  productionOutput      ProductionOutput?

  @@index([productId, expirationDate])
  @@index([supplierId, supplierLotNumber])
}

model InventoryLotStock {
  id          String     @id @default(cuid()) @db.VarChar(30)
  lotId       String     @db.VarChar(30)
  warehouseId String     @db.VarChar(30)
  onHand      Decimal    @default(0) @db.Decimal(14, 3)
  createdAt   DateTime   @default(now()) @db.DateTime(3)
  updatedAt   DateTime   @updatedAt @db.DateTime(3)
  lot         ProductLot @relation(fields: [lotId], references: [id], onDelete: Restrict)
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([lotId, warehouseId])
  @@index([warehouseId, onHand])
}

model InventoryLotMovement {
  id           String          @id @default(cuid()) @db.VarChar(30)
  lotId        String          @db.VarChar(30)
  warehouseId  String          @db.VarChar(30)
  type         LotMovementType
  quantity     Decimal         @db.Decimal(14, 3)
  balanceAfter Decimal         @db.Decimal(14, 3)
  reference    String?         @db.VarChar(100)
  note         String?         @db.VarChar(500)
  createdAt    DateTime        @default(now()) @db.DateTime(3)
  lot          ProductLot      @relation(fields: [lotId], references: [id], onDelete: Restrict)
  warehouse    Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([lotId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([reference])
}

model WarehouseLotPlacement {
  id           String                @id @default(cuid()) @db.VarChar(30)
  warehouseId  String                @db.VarChar(30)
  objectId     String                @db.VarChar(30)
  lotId        String                @db.VarChar(30)
  locationCode String                @default("") @db.VarChar(80)
  quantity     Decimal               @default(0) @db.Decimal(14, 3)
  createdAt    DateTime              @default(now()) @db.DateTime(3)
  updatedAt    DateTime              @updatedAt @db.DateTime(3)
  warehouse    Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  object       WarehouseVisualObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  lot          ProductLot            @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@unique([objectId, lotId, locationCode])
  @@index([warehouseId, lotId])
}

model PosSaleLotAllocation {
  id          String      @id @default(cuid()) @db.VarChar(30)
  saleItemId  String      @db.VarChar(30)
  lotId       String      @db.VarChar(30)
  warehouseId String      @db.VarChar(30)
  quantity    Decimal     @db.Decimal(14, 3)
  createdAt   DateTime    @default(now()) @db.DateTime(3)
  saleItem    PosSaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  lot         ProductLot  @relation(fields: [lotId], references: [id], onDelete: Restrict)
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([saleItemId, lotId])
  @@index([lotId])
}

model PosReturnLotAllocation {
  id           String        @id @default(cuid()) @db.VarChar(30)
  returnItemId String        @db.VarChar(30)
  lotId        String        @db.VarChar(30)
  warehouseId  String        @db.VarChar(30)
  quantity     Decimal       @db.Decimal(14, 3)
  createdAt    DateTime      @default(now()) @db.DateTime(3)
  returnItem   PosReturnItem @relation(fields: [returnItemId], references: [id], onDelete: Cascade)
  lot          ProductLot    @relation(fields: [lotId], references: [id], onDelete: Restrict)
  warehouse    Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([returnItemId, lotId])
  @@index([lotId])
}

model OrderItemLotAllocation {
  id          String     @id @default(cuid()) @db.VarChar(30)
  orderItemId String     @db.VarChar(30)
  lotId       String     @db.VarChar(30)
  warehouseId String     @db.VarChar(30)
  quantity    Decimal    @db.Decimal(14, 3)
  createdAt   DateTime   @default(now()) @db.DateTime(3)
  orderItem   OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  lot         ProductLot @relation(fields: [lotId], references: [id], onDelete: Restrict)
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, lotId, warehouseId])
  @@index([lotId])
}

model DispatchLotAllocation {
  id             String       @id @default(cuid()) @db.VarChar(30)
  dispatchItemId String       @db.VarChar(30)
  lotId          String       @db.VarChar(30)
  quantity       Decimal      @db.Decimal(14, 3)
  createdAt      DateTime     @default(now()) @db.DateTime(3)
  dispatchItem   DispatchItem @relation(fields: [dispatchItemId], references: [id], onDelete: Cascade)
  lot            ProductLot   @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@unique([dispatchItemId, lotId])
  @@index([lotId])
}

model ProductionBatch {
  id                  String                @id @default(cuid()) @db.VarChar(30)
  productionNumber    String                @unique @db.VarChar(40)
  requestKey          String                @unique @db.VarChar(64)
  warehouseId         String                @db.VarChar(30)
  processType         ProductionProcessType
  performedBy         String                @db.VarChar(80)
  notes               String?               @db.VarChar(1000)
  totalInputQuantity  Decimal               @db.Decimal(14, 3)
  totalOutputQuantity Decimal               @db.Decimal(14, 3)
  totalWasteQuantity  Decimal               @db.Decimal(14, 3)
  yieldPercent        Decimal               @db.Decimal(7, 3)
  totalInputCost      Int?
  createdAt           DateTime              @default(now()) @db.DateTime(3)
  warehouse           Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  inputs              ProductionInput[]
  outputs             ProductionOutput[]
  wastes              ProductionWaste[]

  @@index([warehouseId, createdAt])
  @@index([processType, createdAt])
}

model ProductionInput {
  id                String          @id @default(cuid()) @db.VarChar(30)
  productionBatchId String          @db.VarChar(30)
  lotId             String          @db.VarChar(30)
  productId         String          @db.VarChar(30)
  productName       String          @db.VarChar(191)
  unit              UnitType
  quantity          Decimal         @db.Decimal(14, 3)
  unitCostNet       Int?
  totalCostNet      Int?
  createdAt         DateTime        @default(now()) @db.DateTime(3)
  productionBatch   ProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)
  lot               ProductLot      @relation(fields: [lotId], references: [id], onDelete: Restrict)
  product           Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productionBatchId, lotId])
  @@index([lotId])
  @@index([productId])
}

model ProductionOutput {
  id                String          @id @default(cuid()) @db.VarChar(30)
  productionBatchId String          @db.VarChar(30)
  lotId             String          @unique @db.VarChar(30)
  productId         String          @db.VarChar(30)
  productName       String          @db.VarChar(191)
  unit              UnitType
  quantity          Decimal         @db.Decimal(14, 3)
  allocatedCostNet  Int?
  unitCostNet       Int?
  manufacturedAt    DateTime?       @db.DateTime(3)
  expirationDate    DateTime?       @db.DateTime(3)
  createdAt         DateTime        @default(now()) @db.DateTime(3)
  productionBatch   ProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)
  lot               ProductLot      @relation(fields: [lotId], references: [id], onDelete: Restrict)
  product           Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productionBatchId, productId])
  @@index([productId])
}

model ProductionWaste {
  id                String              @id @default(cuid()) @db.VarChar(30)
  productionBatchId String              @db.VarChar(30)
  sourceProductId   String?             @db.VarChar(30)
  sourceProductName String?             @db.VarChar(191)
  type              ProductionWasteType
  quantity          Decimal             @db.Decimal(14, 3)
  note              String?             @db.VarChar(500)
  createdAt         DateTime            @default(now()) @db.DateTime(3)
  productionBatch   ProductionBatch     @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)
  sourceProduct     Product?            @relation(fields: [sourceProductId], references: [id], onDelete: SetNull)

  @@index([productionBatchId])
  @@index([sourceProductId])
}

model Order {
  id                 String         @id @default(cuid()) @db.VarChar(30)
  orderNumber        String         @unique @db.VarChar(40)
  buyOrder           String         @unique @db.VarChar(26)
  idempotencyKey     String         @unique @db.VarChar(191)
  sessionId          String         @db.VarChar(61)
  status             OrderStatus    @default(PENDING_PAYMENT)
  paymentStatus      PaymentStatus  @default(PENDING)
  customerName       String         @db.VarChar(191)
  customerEmail      String         @db.VarChar(191)
  customerPhone      String         @db.VarChar(40)
  customerRut        String?        @db.VarChar(20)
  addressLine        String         @db.VarChar(255)
  addressDetail      String?        @db.VarChar(255)
  commune            String         @db.VarChar(120)
  region             String         @db.VarChar(120)
  deliveryDate       DateTime?      @db.DateTime(3)
  notes              String?        @db.Text
  subtotal           Int
  shipping           Int
  discount           Int            @default(0)
  couponCode         String?        @db.VarChar(100)
  total              Int
  tokenWs            String?        @unique @db.VarChar(191)
  webpayUrl          String?        @db.VarChar(500)
  authorizationCode  String?        @db.VarChar(100)
  paymentTypeCode    String?        @db.VarChar(20)
  installmentsNumber Int?
  cardLastFour       String?        @db.VarChar(4)
  webpayResponse     Json?
  reservationExpires DateTime       @db.DateTime(3)
  createdAt          DateTime       @default(now()) @db.DateTime(3)
  updatedAt          DateTime       @updatedAt @db.DateTime(3)
  items              OrderItem[]
  dispatches         Dispatch[]

  @@index([status, createdAt])
  @@index([customerEmail, createdAt])
}

model OrderItem {
  id                    String                   @id @default(cuid()) @db.VarChar(30)
  orderId               String                   @db.VarChar(30)
  productId             String                   @db.VarChar(30)
  productName           String                   @db.VarChar(191)
  imageUrl              String                   @db.VarChar(500)
  unit                  UnitType
  quantity              Decimal                  @db.Decimal(14, 3)
  unitPrice             Int
  subtotal              Int
  order                 Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product               Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventoryReservations InventoryReservation[]
  lotAllocations        OrderItemLotAllocation[]

  @@index([orderId])
}

model Coupon {
  id              String    @id @default(cuid()) @db.VarChar(30)
  code            String    @unique @db.VarChar(100)
  active          Boolean   @default(true)
  percentOff      Int?
  fixedAmountOff  Int?
  minimumSubtotal Int       @default(0)
  startsAt        DateTime? @db.DateTime(3)
  endsAt          DateTime? @db.DateTime(3)
  usageLimit      Int?
  usedCount       Int       @default(0)
  createdAt       DateTime  @default(now()) @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @db.DateTime(3)
}

model ContactMessage {
  id        String    @id @default(cuid()) @db.VarChar(30)
  name      String    @db.VarChar(191)
  company   String?   @db.VarChar(191)
  email     String    @db.VarChar(191)
  phone     String?   @db.VarChar(40)
  subject   String    @db.VarChar(191)
  message   String    @db.Text
  ipHash    String?   @db.VarChar(191)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  handledAt DateTime? @db.DateTime(3)

  @@index([createdAt])
}

model RateLimitBucket {
  key         String   @id @db.VarChar(191)
  count       Int      @default(0)
  windowStart DateTime @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)
}

model DteFolioSequence {
  id          String         @id @default(cuid()) @db.VarChar(30)
  typeCode    Int
  environment DteEnvironment
  nextFolio   Int            @default(1)
  createdAt   DateTime       @default(now()) @db.DateTime(3)
  updatedAt   DateTime       @updatedAt @db.DateTime(3)

  @@unique([typeCode, environment])
}

model DteDocument {
  id               String          @id @default(cuid()) @db.VarChar(30)
  saleId           String?         @db.VarChar(30)
  returnId         String?         @db.VarChar(30)
  dispatchId       String?         @db.VarChar(30)
  parentId         String?         @db.VarChar(30)
  type             DteDocumentType
  typeCode         Int
  folio            Int
  environment      DteEnvironment
  status           DteStatus       @default(DRAFT)
  issueDate        DateTime         @db.DateTime(3)
  receiverRut      String?          @db.VarChar(20)
  receiverName     String?          @db.VarChar(191)
  receiverGiro     String?          @db.VarChar(191)
  receiverAddress  String?          @db.VarChar(255)
  receiverCommune  String?          @db.VarChar(120)
  receiverCity     String?          @db.VarChar(120)
  netAmount        Int
  exemptAmount     Int              @default(0)
  vatAmount        Int
  vatRate          Int              @default(19)
  totalAmount      Int
  trackId          String?          @db.VarChar(100)
  siiStatusCode    String?          @db.VarChar(80)
  siiStatusMessage String?          @db.VarChar(500)
  xmlDraft         String?          @db.LongText
  xmlSigned        String?          @db.LongText
  responseRaw      String?          @db.LongText
  errorMessage     String?          @db.VarChar(1000)
  issuedAt         DateTime?        @db.DateTime(3)
  sentAt           DateTime?        @db.DateTime(3)
  acceptedAt       DateTime?        @db.DateTime(3)
  createdAt        DateTime         @default(now()) @db.DateTime(3)
  updatedAt        DateTime         @updatedAt @db.DateTime(3)
  sale             PosSale?        @relation(fields: [saleId], references: [id], onDelete: Restrict)
  posReturn        PosReturn?       @relation(fields: [returnId], references: [id], onDelete: Restrict)
  dispatch         Dispatch?        @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  parent           DteDocument?     @relation("DteReferences", fields: [parentId], references: [id], onDelete: Restrict)
  references       DteDocument[]    @relation("DteReferences")
  events           DteEvent[]

  @@unique([environment, typeCode, folio])
  @@index([saleId, createdAt])
  @@index([returnId, createdAt])
  @@index([dispatchId, createdAt])
  @@index([status, createdAt])
  @@index([trackId])
  @@index([parentId])
}

model DteEvent {
  id         String      @id @default(cuid()) @db.VarChar(30)
  documentId String      @db.VarChar(30)
  status     DteStatus
  code       String?     @db.VarChar(80)
  message    String      @db.VarChar(1000)
  raw        String?     @db.LongText
  createdAt  DateTime    @default(now()) @db.DateTime(3)
  document   DteDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
}